<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CampusMapChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textColor">@color/map_text_primary</item>
        <item name="chipBackgroundColor">@android:color/white</item>
        <item name="chipStrokeColor">@color/map_divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ProfileRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ProfileRowIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="tint">@color/text_secondary</item>
    </style>

    <style name="ProfileRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ProfileRowChevron">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="tint">@color/text_hint</item>
    </style>

    <style name="ProfileRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
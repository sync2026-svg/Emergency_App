<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Dark bar background -->
    <LinearLayout
        android:id="@+id/navBarBg"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <!-- Home (active) -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home_24"
                app:tint="@color/nav_active_red" />

            <TextView
                android:id="@+id/labelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/nav_active_red"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Map -->
        <LinearLayout
            android:id="@+id/tabMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Map"
                android:src="@drawable/ic_map_24"
                app:tint="@color/nav_icon_inactive" />

            <TextView
                android:id="@+id/labelMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Map"
                android:textColor="@color/nav_text_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- SOS spacer: icon lives in the raised circle above; only the label sits here -->
        <LinearLayout
            android:id="@+id/tabSos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="2dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/labelSos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOS"
                android:textColor="@color/nav_icon_white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Alerts -->
        <LinearLayout
            android:id="@+id/tabAlerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Alerts"
                android:src="@drawable/ic_alerts_24"
                app:tint="@color/nav_icon_inactive" />

            <TextView
                android:id="@+id/labelAlerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Alerts"
                android:textColor="@color/nav_text_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_profile_24"
                app:tint="@color/nav_icon_inactive" />

            <TextView
                android:id="@+id/labelProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="@color/nav_text_inactive"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Raised red SOS circle button, overlapping the top edge of the bar -->
    <FrameLayout
        android:id="@+id/btnSos"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_sos_circle"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="SOS"
            android:src="@drawable/ic_sos" />
    </FrameLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".ProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_accent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="52dp"
                android:paddingBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    app:cardCornerRadius="42dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/white">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp"
                        android:contentDescription="Profile photo"
                        app:srcCompat="@drawable/ic_person"
                        app:tint="@color/accent_red" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aditi Sharma"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Student · ID DHSGSU2026041"
                    android:textColor="#FFEBEE"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Verified status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/status_safe_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Verified"
                        app:srcCompat="@drawable/ic_check_circle"
                        app:tint="@color/status_safe" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="University identity verified"
                        android:textColor="@color/status_safe"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Account section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/rowEditProfile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/ProfileRow">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_edit"
                                android:contentDescription="Edit profile" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/ProfileRowText"
                                android:text="Edit Profile" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                style="@style/ProfileRowChevron"
                                app:srcCompat="@drawable/ic_chevron_right"
                                android:contentDescription="Open" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            style="@style/ProfileRowDivider" />

                        <LinearLayout
                            android:id="@+id/rowEmergencyContacts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/ProfileRow">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_phone"
                                android:contentDescription="Emergency contacts" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/ProfileRowText"
                                android:text="Emergency Contacts" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                style="@style/ProfileRowChevron"
                                app:srcCompat="@drawable/ic_chevron_right"
                                android:contentDescription="Open" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            style="@style/ProfileRowDivider" />

                        <LinearLayout
                            android:id="@+id/rowMedicalInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/ProfileRow">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_medical"
                                android:contentDescription="Medical info" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/ProfileRowText"
                                android:text="Medical Info (blood group, allergies)" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                style="@style/ProfileRowChevron"
                                app:srcCompat="@drawable/ic_chevron_right"
                                android:contentDescription="Open" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Safety preferences -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safety Preferences"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_share_location"
                                android:contentDescription="Location sharing" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Share live location during SOS"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <Switch
                                android:id="@+id/switchLocationSharing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minWidth="48dp"
                                android:minHeight="48dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            style="@style/ProfileRowDivider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_notifications"
                                android:contentDescription="Push alerts" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Push notifications for campus alerts"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <Switch
                                android:id="@+id/switchPushAlerts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minWidth="48dp"
                                android:minHeight="48dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            style="@style/ProfileRowDivider" />

                        <LinearLayout
                            android:id="@+id/rowSafetyGuide"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/ProfileRow">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_book"
                                android:contentDescription="Safety guide" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/ProfileRowText"
                                android:text="Safety Guides &amp; Resources" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                style="@style/ProfileRowChevron"
                                app:srcCompat="@drawable/ic_chevron_right"
                                android:contentDescription="Open" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Support -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Support"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/rowHelpCenter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/ProfileRow">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_report"
                                android:contentDescription="Help center" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/ProfileRowText"
                                android:text="Help Center" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                style="@style/ProfileRowChevron"
                                app:srcCompat="@drawable/ic_chevron_right"
                                android:contentDescription="Open" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            style="@style/ProfileRowDivider" />

                        <LinearLayout
                            android:id="@+id/rowMyReports"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/ProfileRow">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                style="@style/ProfileRowIcon"
                                app:srcCompat="@drawable/ic_alert"
                                android:contentDescription="My reports" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/ProfileRowText"
                                android:text="My Submitted Reports" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                style="@style/ProfileRowChevron"
                                app:srcCompat="@drawable/ic_chevron_right"
                                android:contentDescription="Open" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Logout -->
                <TextView
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Log Out"
                    android:textColor="@color/accent_red"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Campus Emergency Response · v1.0"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>